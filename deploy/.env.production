# ─── Suivi Rédaction — Environnement de production ───────────
# Copier ce fichier en .env sur le VPS et modifier les valeurs
# Ce fichier est chargé automatiquement par docker-compose

# JWT Secret — CHANGEZ CE SECRET ABSOLUMENT !
# Générer avec : openssl rand -hex 32
JWT_SECRET=change-this-secret-in-production

# ─── Configuration avancée (optionnel) ──────────────────────
# Port du backend (défaut: 3001)
# PORT=3001

# Port du frontend (défaut: 80)
# FRONTEND_PORT=80

# Nœud du réseau (défaut: production)
# NODE_ENV=production
